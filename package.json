{
  "name": "myapp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "typesPackage": "@myorg/api",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:types": "rm -rf dist-types && tsc -p tsconfig.types.json && bun scripts/make-types-package.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "pack:types": "bun run build:types && cd dist-types && npm pack"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.4",
    "elysia": "~1.4.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
